<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Admin Masuqik Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    (function() {
      const saved = localStorage.getItem('masuqik_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
  <style>
    .admin-container {
      display: flex;
      min-height: 100vh;
    }

    .admin-sidebar {
      width: 260px;
      flex-shrink: 0;
      background: var(--bg-card);
      border-right: 1px solid var(--border);
      padding: 1.5rem 0;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }

    .admin-brand {
      padding: 0 1.5rem 1.5rem 1.5rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }

    .admin-brand-name {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .admin-brand-name span { color: var(--primary); }

    .admin-brand-sub {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-faint);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 0.2rem;
    }

    .admin-menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      padding: 0 0.75rem;
      gap: 0.2rem;
      flex: 1;
    }

    .admin-menu-section {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-faint);
      padding: 0.85rem 0.75rem 0.35rem 0.75rem;
    }

    .admin-menu a {
      color: var(--text-muted);
      padding: 0.65rem 1rem;
      border-radius: var(--radius-sm);
      font-weight: 500;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      transition: all 0.2s;
      text-decoration: none;
      border-left: 3px solid transparent;
    }

    .admin-menu a:hover {
      background: var(--primary-light);
      color: var(--primary);
      border-left-color: var(--primary);
    }

    .admin-menu a.active {
      background: var(--primary-light);
      color: var(--primary);
      font-weight: 700;
      border-left-color: var(--primary);
    }

    .admin-content {
      flex: 1;
      background: var(--bg-main);
      padding: 2rem;
      overflow: auto;
      min-width: 0;
    }

    .admin-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
    }

    .admin-page-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-main);
    }

    /* Stat cards */
    .stat-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--bg-card);
      padding: 1.5rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
    }

    .stat-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md), var(--shadow-glow);
      border-color: var(--border-hover);
    }

    .stat-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 0.5rem;
    }

    .stat-value {
      font-size: 1.75rem;
      font-weight: 900;
      color: var(--text-main);
      line-height: 1;
    }

    .stat-icon {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }

    /* Data table */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--bg-card);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
    }

    .data-table th {
      background: rgba(255,255,255,0.04);
      font-weight: 700;
      color: var(--text-muted);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .data-table td {
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 0.88rem;
      color: var(--text-main);
    }

    .data-table tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover { background: rgba(255,255,255,0.025); }

    /* Admin forms */
    .admin-form-group {
      margin-bottom: 1.25rem;
    }

    .admin-form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 0.45rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .admin-form-control {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-family: 'Poppins', sans-serif;
      background: rgba(255,255,255,0.04);
      color: var(--text-main);
      outline: none;
      transition: all 0.2s ease;
    }

    .admin-form-control::placeholder { color: var(--text-faint); }

    .admin-form-control:focus {
      border-color: var(--primary);
      background: var(--bg-card-hover);
      box-shadow: 0 0 0 3px var(--primary-glow);
    }

    .admin-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
    }

    .admin-card-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    /* Alert messages */
    .admin-alert {
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .admin-alert-success {
      background: rgba(16,185,129,0.1);
      border: 1px solid rgba(16,185,129,0.25);
      color: #34d399;
    }

    .admin-alert-error {
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.25);
      color: #f87171;
    }

    .admin-alert-warning {
      background: rgba(245,158,11,0.1);
      border: 1px solid rgba(245,158,11,0.25);
      color: #fbbf24;
    }
  </style>
</head>
<body>
  <div class="admin-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <div class="admin-brand">
        <div class="admin-brand-name">Masuqik<span>Store</span></div>
        <div class="admin-brand-sub">Control Panel</div>
      </div>

      <ul class="admin-menu">
        <div class="admin-menu-section">Utama</div>
        <li><a href="/admin/dashboard" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">
          <i data-lucide="layout-dashboard" style="width:15px;height:15px;flex-shrink:0;"></i> Dashboard
        </a></li>
        <li><a href="/admin/orders" class="<%= activeTab === 'orders' ? 'active' : '' %>">
          <i data-lucide="shopping-cart" style="width:15px;height:15px;flex-shrink:0;"></i> Pesanan &amp; Stok
        </a></li>

        <div class="admin-menu-section">Konten</div>
        <li><a href="/admin/products" class="<%= activeTab === 'products' ? 'active' : '' %>">
          <i data-lucide="package" style="width:15px;height:15px;flex-shrink:0;"></i> Produk &amp; Markup
        </a></li>
        <li><a href="/admin/banners" class="<%= activeTab === 'banners' ? 'active' : '' %>">
          <i data-lucide="image" style="width:15px;height:15px;flex-shrink:0;"></i> Banner Promo
        </a></li>

        <div class="admin-menu-section">Sistem</div>
        <li><a href="/admin/users" class="<%= activeTab === 'users' ? 'active' : '' %>">
          <i data-lucide="users" style="width:15px;height:15px;flex-shrink:0;"></i> Kelola Member
        </a></li>
        <li><a href="/admin/settings" class="<%= activeTab === 'settings' ? 'active' : '' %>">
          <i data-lucide="settings" style="width:15px;height:15px;flex-shrink:0;"></i> Pengaturan
        </a></li>
      </ul>

      <div style="padding: 1rem 1.5rem; border-top: 1px solid var(--border); margin-top: 1rem;">
        <div style="font-size: 0.75rem; color: var(--text-faint); margin-bottom: 0.5rem;">
          Login sebagai <strong style="color: var(--text-muted);"><%= user ? user.name : 'Admin' %></strong>
        </div>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <a href="/admin/logout" style="color: #f87171; font-weight: 600; font-size: 0.82rem; display: flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.75rem; border-radius: var(--radius-sm); flex:1; transition: background 0.2s;" onmouseover="this.style.background='rgba(239,68,68,0.08)'" onmouseout="this.style.background='none'">
            <i data-lucide="log-out" style="width:14px;height:14px;"></i> Logout
          </a>
          <button onclick="toggleTheme()" class="theme-toggle" title="Ganti Tema" style="width:34px;height:34px; cursor: pointer; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-main); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="sun" class="icon-sun" style="width:14px;height:14px;"></i>
            <i data-lucide="moon" class="icon-moon" style="width:14px;height:14px;"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-content">
      <div class="admin-header-bar">
        <h1 class="admin-page-title"><%= pageTitle %></h1>
        <div style="font-size: 0.78rem; color: var(--text-muted); background: var(--bg-card); padding: 0.4rem 0.9rem; border-radius: var(--radius-pill); border: 1px solid var(--border);">
          <%= new Date().toLocaleDateString('id-ID', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
        </div>
      </div>

      <%- body %>
    </main>
  </div>
</body>
</html>
