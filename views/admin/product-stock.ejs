<!-- Header & Navigation -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
  <div style="display:flex; align-items:center; gap:0.8rem;">
    <a href="/admin/products?tab=manual" class="btn-pill" style="padding:0.45rem 0.9rem; font-size:0.82rem; background:var(--bg-input); color:var(--text-muted); border:1px solid var(--border); text-decoration:none; gap:0.4rem;">
      <i data-lucide="arrow-left" style="width:14px;height:14px;"></i>
      Kembali ke Produk
    </a>
    <div>
      <span style="font-size:0.75rem; color:var(--accent); font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">STOK PRODUK MANUAL</span>
      <h2 style="font-size:1.25rem; font-weight:800; color:var(--text-main); margin:0.1rem 0 0 0;"><%= product.name %></h2>
    </div>
  </div>

  <div style="display:flex; gap:0.75rem; align-items:center;">
    <div style="background:var(--bg-card); border:1px solid var(--border); padding:0.4rem 1rem; border-radius:var(--radius-sm); font-size:0.82rem;">
      <span style="color:var(--text-faint);">Kategori:</span> <strong style="color:var(--text-main);"><%= product.category %></strong>
    </div>
    <div style="background:var(--bg-card); border:1px solid var(--border); padding:0.4rem 1rem; border-radius:var(--radius-sm); font-size:0.82rem;">
      <span style="color:var(--text-faint);">Harga:</span> <strong style="color:var(--primary);">Rp <%= (product.priceRupiah + product.markupPrice).toLocaleString('id-ID') %></strong>
    </div>
    <div style="background:var(--bg-card); border:1px solid var(--border); padding:0.4rem 1rem; border-radius:var(--radius-sm); font-size:0.82rem;">
      <span style="color:var(--text-faint);">Jumlah Stok:</span> 
      <strong style="color:<%= stockItems.length > 0 ? '#34d399' : '#f87171' %>; font-size:0.95rem;">
        <%= stockItems.length %> item
      </strong>
    </div>
  </div>
</div>

<!-- Flash Alerts -->
<% if (typeof success !== 'undefined' && success) { %>
  <div class="admin-alert admin-alert-success" style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.5rem;">
    <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i>
    <%= success %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="admin-alert admin-alert-error" style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.5rem;">
    <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i>
    <%= error %>
  </div>
<% } %>

<div style="display:grid; grid-template-columns:380px 1fr; gap:1.5rem; align-items:start;">
  <!-- Form Tambah Stok Baru -->
  <div class="admin-card" style="padding:1.5rem;">
    <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem; color:var(--accent);">
      <i data-lucide="layers" style="width:18px;height:18px;"></i>
      <h3 style="font-size:1.05rem; font-weight:800; color:var(--text-main); margin:0;">Input Stok Baru</h3>
    </div>

    <form action="/admin/products/<%= product.id %>/stock/add" method="POST">
      <div class="admin-form-group" style="margin-bottom:1rem;">
        <label class="admin-form-label">Daftar Item Stok (1 Baris = 1 Item) *</label>
        <textarea name="stockText" rows="8" class="admin-form-control" 
                  placeholder="Contoh format:&#10;USER123|PASS456|COOKIE_XYZ&#10;USER789|PASS000|COOKIE_ABC&#10;PROX-888-999-000&#10;VCHR-XYZ-12345"
                  style="font-family:monospace; font-size:0.82rem; line-height:1.5; resize:vertical;" required></textarea>
      </div>

      <!-- Info Helper -->
      <div style="background:var(--primary-light); border:1px solid var(--border); border-radius:var(--radius-sm); padding:0.75rem; font-size:0.76rem; color:var(--text-muted); margin-bottom:1.25rem; line-height:1.45;">
        <div style="font-weight:700; color:var(--primary); margin-bottom:0.2rem; display:flex; align-items:center; gap:0.3rem;">
          <i data-lucide="info" style="width:13px;height:13px;"></i> CARA KERJA SISTEM STOK
        </div>
        - Setiap <strong>1 baris</strong> melambangkan <strong>1 item stok</strong>.<br>
        - Saat pembeli membayar (Misal Qty: 2), sistem akan secara otomatis memotong 2 baris paling atas dan mengirimkannya ke pembeli.
      </div>

      <button type="submit" class="btn-pill btn-accent" style="width:100%; justify-content:center; padding:0.65rem; font-weight:700; gap:0.4rem;">
        <i data-lucide="plus-circle" style="width:15px;height:15px;"></i>
        Tambah ke Stok Available
      </button>
    </form>
  </div>

  <!-- Table / List Item Stok yang Ada -->
  <div class="admin-card" style="padding:0; overflow:hidden;">
    <div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:var(--bg-input);">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <i data-lucide="database" style="width:16px;height:16px; color:var(--primary);"></i>
        <h3 style="font-size:0.98rem; font-weight:800; color:var(--text-main); margin:0;">Available Stock Queue</h3>
      </div>
      <span style="font-size:0.75rem; color:var(--text-faint); font-weight:600;">
        Order Pengeluaran: Baris #1 (Paling Atas) Keluar Pertama
      </span>
    </div>

    <% if (stockItems.length === 0) { %>
      <div style="text-align:center; padding:3.5rem 1.5rem; color:var(--text-muted);">
        <div style="display:inline-flex; align-items:center; justify-content:center; width:56px; height:56px; background:var(--bg-card); border-radius:14px; border:1px solid var(--border); margin-bottom:1rem; color:var(--text-faint);">
          <i data-lucide="box" style="width:26px; height:26px;"></i>
        </div>
        <h4 style="font-size:1rem; font-weight:700; color:var(--text-main); margin-bottom:0.3rem;">Stok Kosong</h4>
        <p style="font-size:0.82rem; margin:0;">Gunakan form di samping kiri untuk menginput data stok produk ini.</p>
      </div>
    <% } else { %>
      <div style="max-height:550px; overflow-y:auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:60px; text-align:center;">Urutan</th>
              <th>Data Stok Item</th>
              <th style="width:90px; text-align:center;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% stockItems.forEach((item, index) => { %>
              <tr>
                <td style="text-align:center;">
                  <span style="display:inline-block; padding:0.15rem 0.5rem; background:<%= index === 0 ? 'rgba(52,211,153,0.15)' : 'var(--bg-input)' %>; color:<%= index === 0 ? '#34d399' : 'var(--text-muted)' %>; border:1px solid var(--border); border-radius:4px; font-size:0.75rem; font-weight:800; font-family:monospace;">
                    #<%= index + 1 %>
                  </span>
                </td>
                <td>
                  <div style="font-family:monospace; font-size:0.83rem; background:var(--bg-input); padding:0.45rem 0.75rem; border-radius:6px; border:1px solid var(--border); word-break:break-all; color:var(--text-main); display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                    <span><%= item %></span>
                    <button type="button" onclick="navigator.clipboard.writeText('<%= item.replace(/'/g, "\\'") %>'); this.innerText='Copied!'; setTimeout(()=>this.innerText='Copy', 1500)" style="background:transparent; border:none; color:var(--accent); font-size:0.72rem; font-weight:700; cursor:pointer; flex-shrink:0;">
                      Copy
                    </button>
                  </div>
                </td>
                <td style="text-align:center;">
                  <form action="/admin/products/<%= product.id %>/stock/<%= index %>/delete" method="POST" onsubmit="return confirm('Hapus item stok urutan #<%= index + 1 %> ini?')">
                    <button type="submit" class="btn-pill" style="padding:0.3rem 0.6rem; font-size:0.72rem; background:rgba(239,68,68,0.1); color:#f87171; border:1px solid rgba(239,68,68,0.25);">
                      <i data-lucide="trash-2" style="width:11px;height:11px;"></i>
                      Hapus
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
