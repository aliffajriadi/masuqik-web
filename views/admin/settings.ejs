<div style="max-width: 650px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow-sm);">
  <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.5rem;">Konfigurasi Webhook Notifikasi Pembelian</h3>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
    Setiap transaksi berhasil (status COMPLETED), sistem akan otomatis mengirim HTTP POST notifikasi ke URL tujuan dengan signing HMAC-SHA256.
  </p>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div style="background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; padding: 0.75rem; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 1.25rem; font-weight: 600;">
      <%= successMessage %>
    </div>
  <% } %>

  <form action="/admin/settings" method="POST">
    <div style="margin-bottom: 1.25rem;">
      <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; cursor: pointer;">
        <input type="checkbox" name="purchase_webhook_enabled" value="true" <%= settings.purchase_webhook_enabled === 'true' ? 'checked' : '' %> style="width: 18px; height: 18px;">
        Aktifkan Webhook Notifikasi Pembelian
      </label>
    </div>

    <div style="margin-bottom: 1.25rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">URL Tujuan Webhook (POST):</label>
      <input type="url" name="purchase_webhook_url" value="<%= settings.purchase_webhook_url || '' %>" placeholder="https://api.yourdomain.com/webhooks/purchase" class="admin-form-control">
    </div>

    <div style="margin-bottom: 1.75rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Secret Key Signing (HMAC-SHA256):</label>
      <input type="text" name="purchase_webhook_secret" value="<%= settings.purchase_webhook_secret || '' %>" placeholder="secret_signing_key_123" class="admin-form-control">
      <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Dikirim via HTTP Header: <code>X-Signature</code></p>
    </div>

    <hr style="border: 0; height: 1px; background: var(--border); margin: 2rem 0;">

    <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.5rem;">Konfigurasi Integrasi Panel (Reseller)</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
      Pengaturan koneksi ke server Panel Store untuk sinkronisasi produk dan pengambilan stok.
    </p>

    <div style="margin-bottom: 1.25rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Panel Base URL:</label>
      <input type="url" name="panel_base_url" value="<%= settings.panel_base_url || '' %>" placeholder="https://panel.contoh.com" class="admin-form-control">
    </div>

    <div style="margin-bottom: 1.75rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Panel API Key:</label>
      <input type="text" name="panel_api_key" value="<%= settings.panel_api_key || '' %>" placeholder="API Key Panel Anda" class="admin-form-control">
    </div>

    <hr style="border: 0; height: 1px; background: var(--border); margin: 2rem 0;">

    <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.5rem;">Konfigurasi Integrasi Payment Gateway</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
      Pengaturan koneksi ke Payment Gateway (Anjay PG).
    </p>

    <div style="margin-bottom: 1.25rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">API Key:</label>
      <input type="text" name="anjay_api_key" value="<%= settings.anjay_api_key || '' %>" placeholder="API Key Gateway" class="admin-form-control">
    </div>

    <div style="margin-bottom: 1.75rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Webhook Secret:</label>
      <input type="text" name="anjay_webhook_secret" value="<%= settings.anjay_webhook_secret || '' %>" placeholder="Secret Key Webhook dari Gateway" class="admin-form-control">
    </div>

    <button type="submit" class="btn-pill btn-primary" style="padding: 0.75rem 1.5rem;">Simpan Pengaturan</button>
  </form>
</div>

<div style="max-width: 650px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow-sm); margin-top: 2rem;">
  <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.5rem;">Ubah Password Admin</h3>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
    Ganti kata sandi akun admin Anda untuk menjaga keamanan akun.
  </p>

  <% if (typeof pwdSuccess !== 'undefined' && pwdSuccess) { %>
    <div style="background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; padding: 0.75rem; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 1.25rem; font-weight: 600;">
      <%= pwdSuccess %>
    </div>
  <% } %>
  
  <% if (typeof pwdError !== 'undefined' && pwdError) { %>
    <div style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #f87171; padding: 0.75rem; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 1.25rem; font-weight: 600;">
      <%= pwdError %>
    </div>
  <% } %>

  <form action="/admin/change-password" method="POST">
    <div style="margin-bottom: 1.25rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Password Lama:</label>
      <input type="password" name="old_password" required placeholder="Masukkan password lama" class="admin-form-control">
    </div>

    <div style="margin-bottom: 1.25rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Password Baru:</label>
      <input type="password" name="new_password" required placeholder="Masukkan password baru" class="admin-form-control">
    </div>

    <div style="margin-bottom: 1.75rem;">
      <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Konfirmasi Password Baru:</label>
      <input type="password" name="confirm_password" required placeholder="Ketik ulang password baru" class="admin-form-control">
    </div>

    <button type="submit" class="btn-pill btn-accent" style="padding: 0.75rem 1.5rem;">Ubah Password</button>
  </form>
</div>
