<table class="data-table">
  <thead>
    <tr>
      <th>Nama Member</th>
      <th>Email</th>
      <th>Nomor HP</th>
      <th>Role</th>
      <th>Status Akun</th>
      <th>Tanggal Mendaftar</th>
      <th>Aksi</th>
    </tr>
  </thead>
  <tbody>
    <% if (users.length === 0) { %>
      <tr><td colspan="7" style="text-align: center; color: var(--text-muted);">Belum ada member terdaftar</td></tr>
    <% } else { %>
      <% users.forEach(u => { %>
        <tr>
          <td><strong><%= u.name %></strong></td>
          <td><%= u.email %></td>
          <td><%= u.phone || '-' %></td>
          <td><span style="background: #e2e8f0; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.75rem; font-weight: 700;"><%= u.role %></span></td>
          <td>
            <span style="padding: 0.25rem 0.6rem; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 700; background: <%= u.status === 'ACTIVE' ? '#dcfce7; color:#166534;' : '#fee2e2; color:#991b1b;' %>">
              <%= u.status %>
            </span>
          </td>
          <td><%= new Date(u.createdAt).toLocaleDateString('id-ID') %></td>
          <td>
            <% if (u.role !== 'SUPERADMIN') { %>
              <form action="/admin/users/<%= u.id %>/toggle" method="POST">
                <button type="submit" class="btn-pill" style="padding: 0.35rem 0.7rem; font-size: 0.75rem; background: <%= u.status === 'ACTIVE' ? '#fee2e2; color:#dc2626;' : '#dcfce7; color:#166534;' %>">
                  <%= u.status === 'ACTIVE' ? 'Blokir' : 'Aktifkan' %>
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>
