<header class="site-header" id="siteHeader">
  <div class="container header-inner">

    <!-- Brand Logo -->
    <a href="/" class="brand-logo" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
      <img src="/images/logo-main-masuqik-page.webp" alt="Masuqik Store" style="height: 48px; width: auto; border-radius: 6px;">
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Main Navigation">
      <ul class="nav-menu">
        <li>
          <a href="/" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>">
            <i data-lucide="home" style="width:15px;height:15px;"></i> Beranda
          </a>
        </li>
        <li>
          <a href="/#katalog" class="nav-link">
            <i data-lucide="package" style="width:15px;height:15px;"></i> Katalog
          </a>
        </li>
        <li>
          <a href="/track" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'track' ? 'active' : '' %>">
            <i data-lucide="search" style="width:15px;height:15px;"></i> Cek Transaksi
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Right Controls -->
    <div class="header-controls">
      <!-- Social Links -->
      <a href="https://www.instagram.com/masuqikcid?stkn=MTNoaDQ5bDRnZHo2NQ==" target="_blank" rel="noopener noreferrer" class="nav-link" aria-label="Instagram" style="padding: 0.4rem; color: var(--text-muted); transition: color 0.2s;" onmouseover="this.style.color='#E1306C'" onmouseout="this.style.color='var(--text-muted)'">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a href="https://discord.gg/8BxZe4zEam" target="_blank" rel="noopener noreferrer" class="nav-link" aria-label="Discord" style="padding: 0.4rem; color: var(--text-muted); transition: color 0.2s;" onmouseover="this.style.color='#5865F2'" onmouseout="this.style.color='var(--text-muted)'">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
        </svg>
      </a>
      
      <div style="width: 1px; height: 24px; background: var(--border); margin: 0 0.2rem;"></div>

      <!-- Theme Toggle -->
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle tema gelap/terang" title="Ganti Tema">
        <span class="icon-moon icon"><i data-lucide="moon" style="width:16px;height:16px;"></i></span>
        <span class="icon-sun icon"><i data-lucide="sun" style="width:16px;height:16px;"></i></span>
      </button>

      <!-- Desktop CTA -->
      <a href="/track" class="btn-pill btn-ghost nav-cta-desktop" style="font-size:0.82rem; padding: 0.5rem 1.1rem; gap:0.4rem;">
        <i data-lucide="search" style="width:14px;height:14px;"></i>
        Cek Pesanan
      </a>
    </div>

  </div>
</header>
