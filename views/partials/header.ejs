<header class="site-header" id="siteHeader">
  <div class="container header-inner">

    <!-- Brand Logo -->
    <a href="/" class="brand-logo" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
      <img src="/images/logo-main-masuqik-page.webp" alt="Masuqik Store" style="height: 48px; width: auto; border-radius: 6px;">
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Main Navigation">
      <ul class="nav-menu">
        <li>
          <a href="/" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>">
            <i data-lucide="home" style="width:15px;height:15px;"></i> Beranda
          </a>
        </li>
        <li>
          <a href="/#katalog" class="nav-link">
            <i data-lucide="package" style="width:15px;height:15px;"></i> Katalog
          </a>
        </li>
        <li>
          <a href="/track" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'track' ? 'active' : '' %>">
            <i data-lucide="search" style="width:15px;height:15px;"></i> Cek Transaksi
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Right Controls -->
    <div class="header-controls">
      <!-- Theme Toggle -->
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle tema gelap/terang" title="Ganti Tema">
        <span class="icon-moon icon"><i data-lucide="moon" style="width:16px;height:16px;"></i></span>
        <span class="icon-sun icon"><i data-lucide="sun" style="width:16px;height:16px;"></i></span>
      </button>

      <!-- Desktop CTA -->
      <a href="/track" class="btn-pill btn-ghost nav-cta-desktop" style="font-size:0.82rem; padding: 0.5rem 1.1rem; gap:0.4rem;">
        <i data-lucide="search" style="width:14px;height:14px;"></i>
        Cek Pesanan
      </a>
    </div>

  </div>
</header>
